---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'Kyrvex Technologies — Engineering tomorrow';
const description = 'Kyrvex Technologies builds secure, intelligent and scalable technology for tomorrow.';
---

<BaseLayout {title} {description}>
  <Header />
  <main>
    <section class="hero shell" aria-labelledby="hero-title">
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="hero-orbit hero-orbit--one" aria-hidden="true"></div>
      <div class="hero-orbit hero-orbit--two" aria-hidden="true"></div>
      <p class="eyebrow hero-kicker"><span></span> Kyrvex Technologies</p>
      <h1 id="hero-title">Engineering<br /><em>tomorrow.</em></h1>
      <div class="hero-bottom">
        <p class="hero-copy">We conceive technology with clarity, resilience and a long horizon in mind.</p>
        <a class="text-link" href="#approach">Discover Kyrvex <span aria-hidden="true">↓</span></a>
      </div>
      <div class="hero-index" aria-hidden="true"><span>01</span><i></i><span>04</span></div>
    </section>

    <section id="approach" class="statement section shell" aria-labelledby="statement-title">
      <p class="eyebrow">Our perspective</p>
      <h2 id="statement-title">Technology should be built to <span>last beyond the moment.</span></h2>
      <p class="statement-copy">Kyrvex is an emerging technology company focused on the foundations that enable organisations to move forward with confidence.</p>
    </section>

    <section id="focus" class="focus section shell" aria-labelledby="focus-title">
      <div class="section-heading">
        <p class="eyebrow">Our focus</p>
        <h2 id="focus-title">Built around<br />what matters.</h2>
      </div>
      <div class="focus-list">
        <article><span>01</span><h3>Secure by design</h3><p>Technology that treats trust, resilience and protection as essential foundations.</p></article>
        <article><span>02</span><h3>Intelligent systems</h3><p>Practical innovation shaped by sharp thinking and emerging capabilities.</p></article>
        <article><span>03</span><h3>Scalable foundations</h3><p>Engineering for the realities of today and the opportunities ahead.</p></article>
      </div>
    </section>

    <section class="horizon" aria-labelledby="horizon-title">
      <div class="shell horizon-content">
        <p class="eyebrow">The horizon</p>
        <h2 id="horizon-title">Technology is not the destination.<br /><span>It is the possibility.</span></h2>
      </div>
      <div class="horizon-light" aria-hidden="true"></div>
    </section>
  </main>
  <Footer />
</BaseLayout>
