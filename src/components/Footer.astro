---
import Brand from './Brand.astro';
---

<footer id="contact" class="site-footer">
  <div class="shell footer-grid">
    <div>
      <Brand />
      <p class="footer-statement">Secure, intelligent and scalable technology for tomorrow.</p>
    </div>
    <div class="footer-contact">
      <p class="eyebrow">Digital presence</p>
      <p class="footer-link">kyrvex.dev <span aria-hidden="true">↗</span></p>
    </div>
  </div>
  <div class="shell footer-bottom">
    <p>© {new Date().getFullYear()} Kyrvex Technologies. All rights reserved.</p>
    <p>Belgium · Engineering tomorrow.</p>
  </div>
</footer>
